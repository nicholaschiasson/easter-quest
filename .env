HOST=0.0.0.0
PORT=8000
INVITE_CODE=test-invite

RUST_LOG=info

PGDATABASE=easter-quest
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSFILE=/run/secrets/db-password

POSTGRES_DB=${PGDATABASE}
POSTGRES_HOST=${PGHOST}
POSTGRES_PORT=${PGPORT}
POSTGRES_USER=${PGUSER}

# Do not save this one to a file, pass it as an inline environment variable
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?The service requires a password to be set by the environment.}

DB_PASSWORD_FILE_CONTENTS="*:*:*:${PGUSER}:${POSTGRES_PASSWORD}"
